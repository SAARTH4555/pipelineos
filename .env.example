# Copy to .env and fill in. Never commit .env.

# HubSpot service key (Development > Keys > Service keys) for a developer TEST account.
PIPELINEOS_HUBSPOT_TOKEN=
# Writes are refused unless the token's portal id matches this value.
PIPELINEOS_ALLOWED_PORTAL=
# HubSpot date-versioned API release used for every path.
PIPELINEOS_HUBSPOT_API_VERSION=2026-09

# Optional: local Ollama for the demo-form classifier. Unset = keyword rules only.
PIPELINEOS_OLLAMA_URL=
PIPELINEOS_OLLAMA_MODEL=llama3.1:8b
